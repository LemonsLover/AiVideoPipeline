<Window x:Class="AiVideoPipeline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AiVideoPipeline.ViewModels"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}" Height="900" Width="1600" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop"
        Style="{StaticResource {x:Type Window}}" Icon="Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportCommand}" />
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Open video / project…" Command="{Binding OpenCommand}" ToolTip="Ctrl+O, or drop a file on the window" />
            <Button DockPanel.Dock="Left" Content="Import from YouTube…" Command="{Binding ImportCommand}" Margin="6,0,0,0"
                    ToolTip="Download a video by link (unlisted videos work) and open it as a project" />
            <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Project.VideoPath, FallbackValue='No project open'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="700" />
                <TextBlock Text="{Binding ProjectInfo}" Style="{StaticResource Muted}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="6,0,0,0"
                    ToolTip="Open %USERPROFILE%\.highlights\settings.json (API key, ffmpeg path, overrides)" />
            <Button DockPanel.Dock="Right" Content="Project folder" Command="{Binding OpenProjectFolderCommand}" Margin="6,0,0,0"
                    IsEnabled="{Binding IsProjectOpen}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding CostText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
        </DockPanel>

        <!-- Left: project settings + pipeline -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding IsProjectOpen}">
                    <TextBlock Text="PROJECT" Style="{StaticResource Header}" Margin="0,0,0,6" />
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Voice track" Style="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="Label" Margin="0,3,0,8" />

                        <TextBlock Text="Editing mode" Style="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Margin="0,3,0,2"
                                  ToolTip="{Binding SelectedMode.Description}" />
                        <TextBlock Text="{Binding SelectedMode.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="Target minutes (0 = mode default)" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding TargetMinutes, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8" />

                        <CheckBox Content="Context captions (what's going on)" IsChecked="{Binding ContextCaptions}" Margin="0,0,0,4"
                                  ToolTip="The plan may add a short on-screen line when a clip needs context" />
                        <CheckBox Content="Title captions in the video" IsChecked="{Binding Titles}" />
                    </StackPanel>

                    <TextBlock Text="PIPELINE" Style="{StaticResource Header}" />
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:StageViewModel">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                                             Fill="{Binding State, Converter={StaticResource StageStateToBrush}}"
                                             ToolTip="{Binding State, Converter={StaticResource StageStateToText}}" />
                                    <StackPanel Grid.Column="1" Margin="4,0,6,0">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Detail}"
                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                        <ProgressBar Margin="0,3,0,0" Maximum="1" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"
                                                     Visibility="Collapsed" x:Name="Bar" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}" VerticalAlignment="Top" Margin="0,0,4,0"
                                            Content="✎" ToolTip="Settings of this step: prompt, model, parameters"
                                            Visibility="{Binding HasSettings, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.EditStageSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Style="{StaticResource SmallButton}" VerticalAlignment="Top"
                                            Content="{Binding State, Converter={StaticResource StageStateToAction}}"
                                            ToolTip="Run this stage (and anything it needs); ↻ re-runs a finished stage"
                                            Command="{Binding DataContext.RunStageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Progress}" Value="{x:Null}">
                                        <Setter TargetName="Bar" Property="IsIndeterminate" Value="True" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Build video" Style="{StaticResource AccentButton}" Command="{Binding BuildVideoCommand}" Margin="0,8,0,6"
                            ToolTip="Runs every missing stage up to highlights.mp4 and youtube.txt" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Content="Open video" Command="{Binding OpenOutputCommand}" Margin="0,0,3,0" />
                        <Button Content="YouTube text" Command="{Binding OpenYouTubeTextCommand}" Margin="3,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Center: player -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="Black" CornerRadius="6">
                <vlc:VideoView x:Name="VideoView" Background="Black" />
            </Border>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <Slider Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Position, Mode=TwoWay}"
                        IsMoveToPointEnabled="True" Focusable="False" />
                <!-- Clips on the source timeline; click one to select it. -->
                <ItemsControl x:Name="Timeline" ItemsSource="{Binding Clips}" Height="14" Margin="5,2,5,0" Background="{StaticResource Brush.Panel}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource Timeline}">
                                        <Binding Path="Start" />
                                        <Binding Path="DataContext.Player.Duration" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="ActualWidth" ElementName="Timeline" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ClipViewModel">
                            <Rectangle x:Name="Marker" Height="14" Fill="{StaticResource Brush.ClipMarker}" Cursor="Hand"
                                       MouseLeftButtonDown="OnTimelineClipClick" ToolTip="{Binding Title}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource Timeline}" ConverterParameter="width">
                                        <Binding Path="Duration" />
                                        <Binding Path="DataContext.Player.Duration" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="ActualWidth" ElementName="Timeline" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Included}" Value="False">
                                    <Setter TargetName="Marker" Property="Fill" Value="{StaticResource Brush.ClipMarkerExcluded}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Command="{Binding PlayPauseCommand}" Width="44" ToolTip="Play / pause (Space)">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▶" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="❚❚" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="{Binding Player.Time, Converter={StaticResource SecondsToTime}, Mode=OneWay}" />
                        <Run Text=" / " Foreground="{StaticResource Brush.TextMuted}" />
                        <Run Text="{Binding Player.Duration, Converter={StaticResource SecondsToTime}, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ClipsSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <Border />
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- Right: clips + editor -->
        <Grid Grid.Row="1" Grid.Column="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Panel}" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CLIPS" Style="{StaticResource Header}" Margin="6,2,0,4" />
                    <ListBox ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ClipViewModel">
                                <Grid Opacity="{Binding Included, Converter={StaticResource IncludedToOpacity}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Included}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="Include in the video" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding Id, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Start, Converter={StaticResource SecondsToTime}, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Duration, StringFormat={}{0:0}s, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Category, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource Brush.Control}" CornerRadius="3" Padding="6,1" VerticalAlignment="Top"
                                            ToolTip="LLM score 0–10">
                                        <TextBlock Text="{Binding Score}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,10,0,0"
                    Visibility="{Binding SelectedClip, Converter={StaticResource NullToVisibility}}">
                <StackPanel DataContext="{Binding SelectedClip}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Included" IsChecked="{Binding Included}" />
                        <TextBlock Text="{Binding Id}" Style="{StaticResource Header}" Margin="0,0,0,6" />
                    </DockPanel>
                    <TextBlock Text="Title (chapter)" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8" />
                    <TextBlock Text="Context caption (empty = none)" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding Caption, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PiecesText}" Style="{StaticResource Muted}" Margin="0,0,0,8"
                               ToolTip="Pauses and boring stretches inside the clip are cut out (jump cuts)" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="6" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Start" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Width="60" VerticalAlignment="Center"
                                   Text="{Binding Start, Converter={StaticResource SecondsToTime}}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button Style="{StaticResource SmallButton}" Content="−2s" Command="{Binding NudgeCommand}" CommandParameter="start:-2" />
                            <Button Style="{StaticResource SmallButton}" Content="−.5" Command="{Binding NudgeCommand}" CommandParameter="start:-0.5" Margin="3,0" />
                            <Button Style="{StaticResource SmallButton}" Content="+.5" Command="{Binding NudgeCommand}" CommandParameter="start:0.5" />
                            <Button Style="{StaticResource SmallButton}" Content="+2s" Command="{Binding NudgeCommand}" CommandParameter="start:2" Margin="3,0" />
                            <Button Style="{StaticResource SmallButton}" Content="⤓ here" Command="{Binding SetStartAtPlayheadCommand}" ToolTip="Start at the player position" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="End" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Width="60" VerticalAlignment="Center"
                                   Text="{Binding End, Converter={StaticResource SecondsToTime}}" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button Style="{StaticResource SmallButton}" Content="−2s" Command="{Binding NudgeCommand}" CommandParameter="end:-2" />
                            <Button Style="{StaticResource SmallButton}" Content="−.5" Command="{Binding NudgeCommand}" CommandParameter="end:-0.5" Margin="3,0" />
                            <Button Style="{StaticResource SmallButton}" Content="+.5" Command="{Binding NudgeCommand}" CommandParameter="end:0.5" />
                            <Button Style="{StaticResource SmallButton}" Content="+2s" Command="{Binding NudgeCommand}" CommandParameter="end:2" Margin="3,0" />
                            <Button Style="{StaticResource SmallButton}" Content="⤓ here" Command="{Binding SetEndAtPlayheadCommand}" ToolTip="End at the player position" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,10,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button DockPanel.Dock="Left" Content="▶ Play clip" Style="{StaticResource AccentButton}" Padding="12,5" Command="{Binding PlayClipCommand}" />
                        <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetClipCommand}" ToolTip="Undo all edits of this clip" />
                        <Border />
                    </DockPanel>

                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="140" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status + log -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <ProgressBar Maximum="1" Value="{Binding StatusProgress, Mode=OneWay, TargetNullValue=0}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6" />
            <Expander>
                <Expander.Header>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                </Expander.Header>
                <ListBox ItemsSource="{Binding Log}" Height="140" Margin="0,6,0,0" x:Name="LogList">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:LogEntry">
                            <TextBlock TextWrapping="Wrap" x:Name="Line">
                                <Run Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                                <Run Text="{Binding Text, Mode=OneWay}" />
                            </TextBlock>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
