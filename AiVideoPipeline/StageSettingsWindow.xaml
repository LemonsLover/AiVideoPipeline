<Window x:Class="AiVideoPipeline.StageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AiVideoPipeline.ViewModels"
        xmlns:local="clr-namespace:AiVideoPipeline"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:StageSettingsViewModel}"
        Title="{Binding Title}" Width="760" Height="820" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" Icon="Assets/app.ico">

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedFields" Source="{Binding Fields}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Reset button shared by all rows: only visible when the value differs from the default. -->
        <DataTemplate x:Key="ResetButton" DataType="vm:SettingFieldViewModel">
            <Button Content="↺" Style="{StaticResource SmallButton}" Command="{Binding ResetCommand}" ToolTip="Reset to default"
                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top" />
        </DataTemplate>

        <DataTemplate x:Key="InlineTemplate" DataType="vm:SettingFieldViewModel">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Top" Margin="0,5,10,0" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseModels"
                                ToolTip="Pick from the OpenRouter catalog, with prices (free and cheap models)"
                                Visibility="{Binding HasModelPicker, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding Help, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding DefaultText}" Style="{StaticResource Muted}" FontSize="11" Opacity="0.7" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ResetButton}" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceTemplate" DataType="vm:SettingFieldViewModel">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Top" Margin="0,5,10,0" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1">
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" />
                    <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding Help, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding DefaultText}" Style="{StaticResource Muted}" FontSize="11" Opacity="0.7" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ResetButton}" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BoolTemplate" DataType="vm:SettingFieldViewModel">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue}" />
                    <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,2,0,0"
                               Visibility="{Binding Help, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ResetButton}" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MultilineTemplate" DataType="vm:SettingFieldViewModel">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="110" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding Help, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ResetButton}" Margin="6,20,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PromptTemplate" DataType="vm:SettingFieldViewModel">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Margin="0,0,0,4">
                        <Run Text="{Binding Label, Mode=OneWay}" />
                        <Run Text="{Binding Field.Key, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                    </TextBlock>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" Height="300" VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="{}{{placeholders}} are filled in by the app; keep the ones the original uses." />
                </StackPanel>
                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ResetButton}" Margin="6,20,0,0" />
            </Grid>
        </DataTemplate>

        <local:SettingTemplateSelector x:Key="TemplateSelector"
                                       Inline="{StaticResource InlineTemplate}" Choice="{StaticResource ChoiceTemplate}"
                                       Bool="{StaticResource BoolTemplate}" Multiline="{StaticResource MultilineTemplate}"
                                       Prompt="{StaticResource PromptTemplate}" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ModeNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding ModeNote, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Reset all to defaults" Command="{Binding ResetAllCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave" MinWidth="90" />
                <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="80" />
            </StackPanel>
            <TextBlock Text="{Binding Footer}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="12,0" />
        </DockPanel>

        <Border Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedFields}}" ItemTemplateSelector="{StaticResource TemplateSelector}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Header}" Margin="0,4,0,8" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
